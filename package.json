{
  "name": "typseo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": "^22.11.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@typseo/playground",
    "dev:docs": "turbo dev --filter=@typseo/docs",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "security:staged": "node scripts/check-git-safety.mjs --staged",
    "security:tracked": "node scripts/check-git-safety.mjs --tracked",
    "security:history": "node scripts/check-git-safety.mjs --history",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "boundaries": "node scripts/check-package-boundaries.mjs",
    "release:check": "pnpm build && node scripts/check-release-artifacts.mjs && node scripts/check-packed-consumer.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}

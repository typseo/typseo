{
  "name": "@typseo/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Framework-independent SEO document analysis",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",

{
  "name": "@typseo/ahrefs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Optional server-side Ahrefs keyword adapter",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noUnusedLocals --noUnusedParameters"
  }
}

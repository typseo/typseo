{
  "name": "@typseo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Optional Typseo editor components",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./seo": {
      "types": "./dist/seo.d.ts",
      "default": "./dist/seo.js"
    },
    "./metadata-editor": {
      "types": "./dist/metadata-editor.d.ts",
      "default": "./dist/metadata-editor.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noUnusedLocals --noUnusedParameters"
  },
  "dependencies": {
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@typseo/core": "workspace:*",
    "@typseo/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.0.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}

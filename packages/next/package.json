{
  "name": "@typseo/next",
  "version": "0.1.0-beta.0",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/typseo/typseo.git",
    "directory": "packages/next"
  },
  "type": "module",
  "description": "Next.js metadata and structured-data helpers for Typseo",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-package-license.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noUnusedLocals --noUnusedParameters"
  },
  "dependencies": {
    "@typseo/core": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=16.0.0"
  },
  "devDependencies": {
    "next": "16.4.2"
  }
}
